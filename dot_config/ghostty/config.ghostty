# Font
font-family = JetBrains Mono
font-size = 13

# ------------------------------------------------------------
# Fedora Slate colors
# ------------------------------------------------------------

background = 111318
foreground = DDE1EA

cursor-color = 8EA5FF
cursor-text = 111318

selection-background = 3D4F80
selection-foreground = FFFFFF

palette = 0=#181B22
palette = 1=#E78284
palette = 2=#A6D189
palette = 3=#E5C890
palette = 4=#8EA5FF
palette = 5=#B6A0FF
palette = 6=#81C8BE
palette = 7=#CDD6E0

palette = 8=#626979
palette = 9=#EA999C
palette = 10=#B5E8A3
palette = 11=#F0D9A0
palette = 12=#AAB9FF
palette = 13=#CAB8FF
palette = 14=#99D9D2
palette = 15=#FFFFFF

# ------------------------------------------------------------
# Transparency / blur
# ------------------------------------------------------------

background-opacity = 0.94
background-blur = true

# Apply opacity even to cells that set a background explicitly.
# Useful with editors/TUI apps if you want the transparency to remain.
background-opacity-cells = true

# ------------------------------------------------------------
# Window
# ------------------------------------------------------------

window-decoration = server

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

confirm-close-surface = false

# ------------------------------------------------------------
# Cursor
# ------------------------------------------------------------

cursor-style = block
cursor-style-blink = false

# Let our configured cursor style win at the Fish prompt.
shell-integration-features = no-cursor

# ------------------------------------------------------------
# Shell integration
# ------------------------------------------------------------

shell-integration = fish
